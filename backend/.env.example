# Copie para .env (nunca versione o .env de verdade) e preencha.
#
# Gere CERT_MASTER_KEY com:
#   python3 -c "from app.crypto import gerar_chave_local; print(gerar_chave_local())"
#
# Gere SESSION_SECRET_KEY com:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Em produção (Railway/Render/...), estes valores vão nas "Variables" /
# "Environment" do serviço, não neste arquivo — o .env local é só pra rodar
# na sua máquina.

# String de conexão do role de RUNTIME da aplicação (NÃO o superusuário do
# provedor — ver scripts/provisionar_banco.sql pro porquê).
DATABASE_URL=postgresql+psycopg://nfse_app:troque-a-senha@localhost:5432/nfse_saas

# Chave Fernet (32 bytes urlsafe-base64) que criptografa o certificado A1 em
# repouso. TROQUE em produção — o valor default em app/config.py é só de
# desenvolvimento.
CERT_MASTER_KEY=

# Assina o cookie de sessão do login. TROQUE em produção — o valor default
# em app/config.py é só de desenvolvimento. Trocar depois desloga todo mundo
# (não é destrutivo pra dado nenhum).
SESSION_SECRET_KEY=

# Origem pública que serve o frontend (e faz proxy de /api pro backend —
# ver frontend/src/lib/api.ts). Usada pra montar links que saem em e-mail
# (confirmação de cadastro) e redirects (Stripe Checkout/Portal, callback
# do login com Google). Default é o Vite dev server local.
APP_BASE_URL=http://localhost:5173

# --- Envio de e-mail (Resend) — cadastro público self-service. Vazio =
# EmailSenderConsole (só loga, nunca falha o cadastro) — ver
# app/services/email.py. Preencha quando a conta Resend existir.
RESEND_API_KEY=
EMAIL_REMETENTE=NotaFácil <onboarding@resend.dev>

# --- Cobrança (Stripe) — Marco 15, item 4. Vazio = endpoints de cobrança
# respondem "não configurado" em vez de chamar a API — ver
# app/services/billing.py. Preencha quando a conta Stripe existir.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MENSAL=
STRIPE_DIAS_TRIAL=14

# --- Login/cadastro via Google (Marco 16, item 1). Vazio = endpoints de
# OAuth respondem "não configurado" em vez de montar uma URL de
# autorização que a Google ia rejeitar mesmo assim — ver
# app/services/google_oauth.py. Preencha quando o projeto OAuth existir
# (Google Cloud Console > APIs e serviços > Credenciais > ID do cliente
# OAuth, tipo "Web application", com
# {APP_BASE_URL}/api/auth/google/callback cadastrado como URI de
# redirecionamento autorizado).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
